version: "0.3.0"
date-released: "2026-10-06"
license: MIT
repository-code: "https://github.com/tommycarstensen/coxstream"
url: "https://github.com/tommycarstensen/coxstream"
# Concept DOI only. It always resolves to the newest release, so it never goes
# stale. A version DOI committed here is by construction the previous release's,
# which is how this file came to say 0.1.1 while PyPI, the tag and pyproject all
# said 0.2.0, mislabelling the Zenodo record for v0.2.0.
doi: "10.5281/zenodo.20693783"
keywords:
  - survival analysis
  - Cox proportional hazards
  - out-of-core
  - streaming
